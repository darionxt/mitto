# GN args for the native core's build directory, out/mitto. The bootstrap
# script copies this file there; edit it here, not in the workspace.

is_debug = false
is_component_build = false
symbol_level = 1

# The library runs inside other programs, such as Python. It must not replace
# their allocator, and a failed DCHECK must not abort them.
use_allocator_shim = false
enable_backup_ref_ptr_support = false
dcheck_always_on = false

# Links ICU's data into the library, so that no data file has to ship with it.
# //url needs that data for hostnames that are not ASCII.
icu_use_data_file = false

# On Linux, //net uses these desktop libraries only for GNOME's proxy settings
# and the desktop portal's metered-network state, and mitto uses neither. A
# machine that installs the library may not have them. They do nothing on macOS.
use_glib = false
use_gio = false
use_dbus = false

# Leaves out NSS and NSPR too, so that the Chrome Root Store is the only source
# of trust on Linux. This needs the //net patch in tools/workspace/patches. They
# do nothing on macOS.
use_nss_client_certs = false
use_nss_server_certs = false
