Let //mitto use libxml and libxslt.

The Page parses XML documents as Blink's XMLDocumentParser does, on libxml2,
and runs XSLT as Blink's XSLTProcessor does, on libxslt. Both libraries keep
their visibility to the targets that the Security Team agreed to, which
Blink's are. This adds //mitto/* beside them; nothing else changes.

diff --git a/third_party/libxml/BUILD.gn b/third_party/libxml/BUILD.gn
index b435302..84a763e 100644
--- a/third_party/libxml/BUILD.gn
+++ b/third_party/libxml/BUILD.gn
@@ -149,6 +149,9 @@ static_library("libxml") {
     "//third_party/fontconfig:*",
     "//third_party/libxslt",
     "//third_party/maldoca/*",
+
+    # mitto's Page parses XML as Blink's XMLDocumentParser does.
+    "//mitto/*",
   ]
   if (is_ios) {
     foreach(tgt, ios_libxml_visibility_additions) {
diff --git a/third_party/libxslt/BUILD.gn b/third_party/libxslt/BUILD.gn
index 6460d87..5f5242a 100644
--- a/third_party/libxslt/BUILD.gn
+++ b/third_party/libxslt/BUILD.gn
@@ -109,5 +109,10 @@ static_library("libxslt") {
 
   deps = [ "//third_party/libxml" ]
 
-  visibility = [ "//third_party/blink/renderer/*" ]
+  visibility = [
+    "//third_party/blink/renderer/*",
+
+    # mitto's Page runs XSLT as Blink's XSLTProcessor does.
+    "//mitto/*",
+  ]
 }
