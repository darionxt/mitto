    "xml_tree_builder.h",
    "xml_tree_viewer.cc",
    "xml_tree_viewer.h",
  ]

  # What //mitto/bindings:generate_bindings writes for these classes and for
  # every other interface a page can reach.
  foreach(file, mitto_bindings_generated_dom_files) {
    sources += [ "$root_gen_dir/mitto/bindings/$file" ]
  }
  public_deps = [
    "//mitto:page_channel",
    "//mitto/bindings",
    "//mitto/css:parser",
  ]
  deps = [
    "//base",
    "//base/third_party/double_conversion",
    "//crypto",
    "//mitto:header_rules",
    "//mitto:mime_types",
    "//mitto:string_hasher",
    "//mitto/encoding",
    "//mitto/html:tokenizer",
    "//mitto/xml:libxml",
    "//mitto/xml:xml_ffi",
    "//net/base:registry_controlled_domains",
    "//third_party/icu",
    "//third_party/zlib",
    "//url",
    "//v8",
  ]
}

# Runs html5lib's tree construction tests, which native/test/html5lib_tree
# holds, against the tree builder, on V8's C++ heap as the Page program has it.
executable("html_tree_builder_test") {
  sources = [ "//mitto/test/html_tree_builder_test.cc" ]
  deps = [
    ":dom",
    "//base",
    "//mitto/page:icu_data",
    "//mitto/page:v8_snapshot",
    "//third_party/icu",
    "//v8",
  ]

  # As the Page program leaves it out, since it runs V8 too: see
  # native/page/BUILD.gn.
  if (is_win) {
    configs -= [ "//build/config/compiler:cet_shadow_stack" ]
  }
}

# Only the runtime-fuzz build loads this, so that no other build of the Runtime
# reads //testing.
if (use_libfuzzer) {
  import("//testing/libfuzzer/fuzzer_test.gni")

  # Feeds any markup to the tree builder, on V8's C++ heap as the test does.
  fuzzer_test("html_tree_builder_fuzzer") {
    sources = [ "//mitto/test/html_tree_builder_fuzzer.cc" ]
    deps = [
      ":dom",
      "//base",
      "//mitto/page:icu_data",
      "//mitto/page:v8_snapshot",
      "//third_party/icu",
      "//v8",
    ]
  }

  # Feeds any XML to the code that drives libxml2 and the Rust xml crate, on
  # V8's C++ heap as the Page program has it.
  fuzzer_test("xml_parser_fuzzer") {
    sources = [ "//mitto/test/xml_parser_fuzzer.cc" ]
    deps = [
      ":dom",
      "//base",
      "//mitto/page:icu_data",
      "//mitto/page:v8_snapshot",
      "//third_party/icu",
      "//v8",
    ]
  }

  # What the runtime-fuzz build builds: both fuzz targets on V8's heap.
  group("runtime_fuzzers") {
    testonly = true
    deps = [
      ":html_tree_builder_fuzzer",
      ":xml_parser_fuzzer",
    ]
  }
}
