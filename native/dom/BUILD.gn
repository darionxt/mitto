# Runs html5lib's tree construction tests, which native/test/html5lib_tree
# holds, against the tree builder, on V8's C++ heap as the Page program has it.
executable("html_tree_builder_test") {
  sources = [ "//mitto/test/html_tree_builder_test.cc" ]
  deps = [
    ":dom",
    "//base",
    "//mitto/page:icu_data",
    "//mitto/page:v8_snapshot",
    "//third_party/icu",
    "//v8",
  ]

  # As the Page program leaves it out, since it runs V8 too: see
  # native/page/BUILD.gn.
  if (is_win) {
    configs -= [ "//build/config/compiler:cet_shadow_stack" ]
  }
}
