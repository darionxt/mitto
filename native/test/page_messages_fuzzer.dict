# The headers of the frames that a Page sends: a 32-bit little-endian payload
# size, then a 32-bit little-endian type.
"\x04\x00\x00\x00\x01\x00\x00\x00"
"\x01\x00\x00\x00"
"\x02\x00\x00\x00"
"\x05\x00\x00\x00"
"\x09\x00\x00\x00\x05\x00\x00\x00"
"\x00\x00\x00\x01"
# What a result holds.
"Uncaught "
"null"
"\"\\ud800\""
"\xef\xbf\xbf"
