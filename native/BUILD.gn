# The native core: a shared library that links //net and exports only the C API
# in include/mitto/mitto.h. tools/workspace/bootstrap.py links this directory
# into the Chromium checkout as //mitto.

import("//build/config/sanitizers/sanitizers.gni")

declare_args() {
  # Adds the Runtime's targets: the Page program, with V8, and Blink's Web IDL
  # database. A build directory of their own turns it on with
  # tools/workspace/runtime_args.gn, which also has what else they need. The
  # source export does not carry their files yet, so builds from it leave it
  # off.
  mitto_enable_runtime = false
}

config("public_api") {
  include_dirs = [ "include" ]
}

# ICU's data, cut down to the items that the library's code can read: about
# 0.3 MB of Chromium's 10.8 MB. ICU's build leaves its own data out, as
# tools/workspace/args.gn asks, so every program here that links ICU needs this.
action("icu_data_assembly") {
  script = "make_icu_data.py"
  inputs = [ "//third_party/icu/common/icudtl.dat" ]
  args = []
  if (is_win) {
    # The assembler there reads another syntax, so the assembly goes into C++,
    # as ICU's own build does it there.
    outputs = [ "$target_gen_dir/icudtl_dat.cc" ]
    args += [ "--format=coff" ]
  } else {
    outputs = [ "$target_gen_dir/icudtl_dat.S" ]
    if (is_mac) {
      args += [ "--format=mach-o" ]
    }
  }
  args += rebase_path(inputs + outputs, root_build_dir)
}

source_set("icu_data") {
  sources = get_target_outputs(":icu_data_assembly")
  deps = [ ":icu_data_assembly" ]
}

shared_library("mitto_core") {
  public = [ "include/mitto/mitto.h" ]
  sources = [
    "body_stream.cc",
    "body_stream.h",
    "client_hints.cc",
    "client_hints.h",
    "connect_retrying_socket_factory.cc",
    "connect_retrying_socket_factory.h",
    "cookie_json.cc",
    "cookie_json.h",
    "directory_lock.h",
    "feature_list.cc",
    "feature_list.h",
    "fetch_rules.cc",
    "fetch_rules.h",
    "http_header_map.cc",
    "http_header_map.h",
    "ignore_errors_cert_verifier.cc",
    "ignore_errors_cert_verifier.h",
    "mitto_core.cc",
    "network_quality.cc",
    "network_quality.h",
    "network_session_configurator.cc",
    "network_session_configurator.h",
    "ready_requests.cc",
    "ready_requests.h",
    "request_channel.cc",
    "request_channel.h",
    "request_options.cc",
    "request_options.h",
    "sec_header_helpers.cc",
    "sec_header_helpers.h",
    "session_settings.cc",
    "session_settings.h",
    "socks5_auth_exchange.cc",
    "socks5_auth_exchange.h",
    "socks5_auth_socket_factory.cc",
    "socks5_auth_socket_factory.h",
    "ssl_config_service_mojo.cc",
    "ssl_config_service_mojo.h",
    "string_hasher.cc",
    "string_hasher.h",
    "stub_resolver_config_reader.cc",
    "stub_resolver_config_reader.h",
  ]
  if (is_win) {
    sources += [
      "directory_lock_win.cc",
      "pin_library.h",
      "pin_library_win.cc",
    ]
  } else {
    sources += [ "directory_lock_posix.cc" ]
  }
  public_configs = [ ":public_api" ]

  # Makes MITTO_EXPORT export the C API, where Windows needs to know.
  defines = [ "MITTO_IMPLEMENTATION" ]
  deps = [
    ":icu_data",
    "//base",
    "//crypto",
    "//net",
    "//third_party/boringssl",
    "//url",
  ]

  # Hidden visibility is not enough. Some code in the tree, such as the
  # allocation functions, is exported regardless, and an exported C++ symbol
  # could clash with one in the process that loads the library. On Windows a
  # library exports what this list names and what its code marks dllexport, and
  # //base marks one function so: see docs/building.md.
  if (is_win) {
    inputs = [ "mitto_core.def" ]
    ldflags = [ "/DEF:" + rebase_path(inputs[0], root_build_dir) ]
  } else if (is_mac) {
    inputs = [ "mitto_core.exports" ]
    ldflags = [
      "-Wl,-exported_symbols_list," + rebase_path(inputs[0], root_build_dir),
      "-Wl,-install_name,@rpath/libmitto_core.dylib",
    ]
  } else {
    inputs = [ "mitto_core.lds" ]
    ldflags = [
      "-Wl,--version-script=" + rebase_path(inputs[0], root_build_dir),

      # The network thread never stops, so dlclose() must not unload its code.
      # macOS has no such flag, and dyld keeps this library loaded without one.
      # On Windows the library pins itself, see pin_library.h.
      "-Wl,-z,nodelete",
    ]
  }
}

executable("mitto_core_test") {
  sources = [ "test/mitto_core_test.c" ]
  deps = [ ":mitto_core" ]

  # This program stands in for an outside caller of the C API. Chromium's rules
  # for its own C++ do not apply to it or to the header as C sees it.
  configs -= [
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
  ]

  # Windows looks for the library next to the program without being told.
  if (is_mac) {
    ldflags = [ "-Wl,-rpath,@loader_path" ]
  } else if (!is_win) {
    configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  }
}

# Only the fuzz build loads this, so that no other build reads //testing.
if (use_libfuzzer) {
  import("//testing/libfuzzer/fuzzer_test.gni")

  fuzzer_test("client_hints_fuzzer") {
    # The parser and not the library, whose exports list hides everything but the
    # C API.
    sources = [
      "client_hints.cc",
      "client_hints.h",
      "test/client_hints_fuzzer.cc",
    ]
    additional_configs = [ ":public_api" ]
    deps = [
      ":icu_data",
      "//base",
      "//net",
      "//url",
    ]
  }

  fuzzer_test("cookies_fuzzer") {
    # The parser and not the library, whose exports list hides everything but the
    # C API.
    sources = [
      "cookie_json.cc",
      "cookie_json.h",
      "include/mitto/mitto.h",
      "test/cookies_fuzzer.cc",
    ]
    additional_configs = [ ":public_api" ]
    deps = [
      ":icu_data",
      "//base",
      "//net",
      "//url",
    ]
  }

  fuzzer_test("request_options_fuzzer") {
    # The parser and not the library, whose exports list hides everything but the
    # C API.
    sources = [
      "include/mitto/mitto.h",
      "request_options.cc",
      "request_options.h",
      "test/request_options_fuzzer.cc",
    ]
    additional_configs = [ ":public_api" ]
    deps = [
      ":icu_data",
      "//base",
      "//net",
      "//url",
    ]
  }

  fuzzer_test("session_settings_fuzzer") {
    # The parser and not the library, whose exports list hides everything but the
    # C API.
    sources = [
      "ignore_errors_cert_verifier.h",
      "include/mitto/mitto.h",
      "network_quality.cc",
      "network_quality.h",
      "session_settings.cc",
      "session_settings.h",
      "socks5_auth_exchange.cc",
      "socks5_auth_exchange.h",
      "string_hasher.cc",
      "string_hasher.h",
      "test/session_settings_fuzzer.cc",
    ]
    additional_configs = [ ":public_api" ]
    deps = [
      ":icu_data",
      "//base",
      "//crypto",
      "//net",
      "//url",
    ]
  }

  fuzzer_test("socks5_auth_fuzzer") {
    # The parser and not the library, whose exports list hides everything but the
    # C API.
    sources = [
      "socks5_auth_exchange.cc",
      "socks5_auth_exchange.h",
      "test/socks5_auth_fuzzer.cc",
    ]
    deps = [
      ":icu_data",
      "//base",
      "//net",
    ]
  }
}

group("mitto") {
  testonly = use_libfuzzer
  deps = [
    ":mitto_core",
    ":mitto_core_test",
    "html",
  ]
  if (use_libfuzzer) {
    deps += [
      ":client_hints_fuzzer",
      ":cookies_fuzzer",
      ":request_options_fuzzer",
      ":session_settings_fuzzer",
      ":socks5_auth_fuzzer",
    ]
  }
}

if (mitto_enable_runtime) {
  # The Runtime's targets, which a build directory of their own builds without
  # the library: on Linux, a shared library takes every object of each static
  # library it links, so ICU's stub data, which runtime_args.gn turns on for
  # V8's build, would clash there with //mitto:icu_data.
  group("runtime") {
    deps = [
      "bindings:web_idl_database",
      "page:mitto_page",
    ]
  }
}
