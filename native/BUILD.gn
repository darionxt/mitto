# The native core: a shared library that links //net and exports only the C API
# in include/mitto/mitto.h. tools/workspace/bootstrap links this directory into
# the Chromium checkout as //mitto.

import("//build/config/sanitizers/sanitizers.gni")

config("public_api") {
  include_dirs = [ "include" ]
}

shared_library("mitto_core") {
  public = [ "include/mitto/mitto.h" ]
  sources = [
    "body_stream.cc",
    "body_stream.h",
    "cookie_json.cc",
    "cookie_json.h",
    "feature_list.cc",
    "feature_list.h",
    "ignore_errors_cert_verifier.cc",
    "ignore_errors_cert_verifier.h",
    "mitto_core.cc",
    "network_session_configurator.cc",
    "network_session_configurator.h",
    "ready_requests.cc",
    "ready_requests.h",
    "request_channel.cc",
    "request_channel.h",
    "request_options.cc",
    "request_options.h",
    "session_settings.cc",
    "session_settings.h",
    "ssl_config_service_mojo.cc",
    "ssl_config_service_mojo.h",
    "stub_resolver_config_reader.cc",
    "stub_resolver_config_reader.h",
  ]
  public_configs = [ ":public_api" ]
  deps = [
    "//base",
    "//crypto",
    "//net",
    "//third_party/boringssl",
    "//url",
  ]

  # Hidden visibility is not enough. Some code in the tree, such as the
  # allocation functions, is exported regardless, and an exported C++ symbol
  # could clash with one in the process that loads the library.
  if (is_mac) {
    inputs = [ "mitto_core.exports" ]
    ldflags = [
      "-Wl,-exported_symbols_list," + rebase_path(inputs[0], root_build_dir),
      "-Wl,-install_name,@rpath/libmitto_core.dylib",
    ]
  } else {
    inputs = [ "mitto_core.lds" ]
    ldflags = [
      "-Wl,--version-script=" + rebase_path(inputs[0], root_build_dir),

      # The network thread never stops, so dlclose() must not unload its code.
      # macOS has no such flag, and dyld keeps this library loaded without one.
      "-Wl,-z,nodelete",
    ]
  }
}

executable("mitto_core_test") {
  sources = [ "test/mitto_core_test.c" ]
  deps = [ ":mitto_core" ]

  # This program stands in for an outside caller of the C API. Chromium's rules
  # for its own C++ do not apply to it or to the header as C sees it.
  configs -= [
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
  ]

  if (is_mac) {
    ldflags = [ "-Wl,-rpath,@loader_path" ]
  } else {
    configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
  }
}

# Only the fuzz build loads this, so that no other build reads //testing.
if (use_libfuzzer) {
  import("//testing/libfuzzer/fuzzer_test.gni")

  fuzzer_test("cookies_fuzzer") {
    # The parser and not the library, whose exports list hides everything but the
    # C API.
    sources = [
      "cookie_json.cc",
      "cookie_json.h",
      "test/cookies_fuzzer.cc",
    ]
    additional_configs = [ ":public_api" ]
    deps = [
      "//base",
      "//net",
      "//url",
    ]
  }

  fuzzer_test("request_options_fuzzer") {
    # The parser and not the library, whose exports list hides everything but the
    # C API.
    sources = [
      "request_options.cc",
      "request_options.h",
      "test/request_options_fuzzer.cc",
    ]
    additional_configs = [ ":public_api" ]
    deps = [
      "//base",
      "//net",
      "//url",
    ]
  }

  fuzzer_test("session_settings_fuzzer") {
    # The parser and not the library, whose exports list hides everything but the
    # C API.
    sources = [
      "ignore_errors_cert_verifier.h",
      "session_settings.cc",
      "session_settings.h",
      "test/session_settings_fuzzer.cc",
    ]
    additional_configs = [ ":public_api" ]
    deps = [
      "//base",
      "//net",
      "//url",
    ]
  }
}

group("mitto") {
  testonly = use_libfuzzer
  deps = [
    ":mitto_core",
    ":mitto_core_test",
  ]
  if (use_libfuzzer) {
    deps += [
      ":cookies_fuzzer",
      ":request_options_fuzzer",
      ":session_settings_fuzzer",
    ]
  }
}
