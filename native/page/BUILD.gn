# The Page program, which runs a Page's scripts in a process of its own, on the
# Engine Release's V8 with the settings Chrome builds it with. It stands alone:
# the library does not link V8, and this program does not link the library.
# docs/building.md says why, and why the program holds the data it reads.

# Writes the file `input` into an assembly file, under the symbol `symbol`, so
# that the program holds its bytes and opens no file to read them.
template("embedded_data") {
  if (is_win) {
    # The assembler there reads another syntax, so the assembly goes into C++,
    # as ICU's own build does it there.
    _assembly = "$target_gen_dir/${target_name}.cc"
  } else {
    _assembly = "$target_gen_dir/${target_name}.S"
  }

  action("${target_name}_assembly") {
    forward_variables_from(invoker, [ "deps" ])
    script = "embed_data.py"
    inputs = [ invoker.input ]
    outputs = [ _assembly ]
    args = [
      "--symbol",
      invoker.symbol,
    ]
    if (is_win) {
      args += [ "--format=coff" ]
    } else if (is_mac) {
      args += [ "--format=mach-o" ]
    }
    args += rebase_path(inputs + outputs, root_build_dir)
  }

  source_set(target_name) {
    sources = [ _assembly ]
    deps = [ ":${target_name}_assembly" ]
  }
}

# ICU's whole data file, which V8's Intl reads, as Chrome ships it. The library
# holds only the few items that its code reads: see //mitto:icu_data.
embedded_data("icu_data") {
  input = "//third_party/icu/common/icudtl.dat"
  symbol = "mitto_icu_data"
}

# V8's startup snapshot, which V8's build writes beside the program because
# Chrome builds V8 to read it from a file.
embedded_data("v8_snapshot") {
  input = "$root_out_dir/snapshot_blob.bin"
  symbol = "mitto_v8_snapshot"
  deps = [ "//v8:run_mksnapshot_default" ]
}

executable("mitto_page") {
  sources = [
    "document_loader.cc",
    "document_loader.h",
    "mitto_page.cc",
    "page_fetcher.cc",
    "page_fetcher.h",
    "page_platform.cc",
    "page_platform.h",
    "page_reporter.cc",
    "page_reporter.h",
    "page_requests.cc",
    "page_requests.h",
    "script_runner.cc",
    "script_runner.h",
    "session_channel.cc",
    "session_channel.h",
    "session_cookie_jar.cc",
    "session_cookie_jar.h",
    "wall_clock_clamper.cc",
    "wall_clock_clamper.h",
  ]
  deps = [
    ":icu_data",
    ":v8_snapshot",
    "//base",
    "//mitto:page_channel",
    "//mitto/dom",
    "//third_party/icu",
    "//url",
    "//v8",
  ]

  # V8's deoptimizer rewrites return addresses, which Windows' hardware-enforced
  # shadow stacks (CET) end the process for. V8's own programs leave the linker
  # flag that turns them on out unless v8_enable_cet_shadow_stack, which is off,
  # and Chrome starts its renderers with CET disabled
  # (sandbox/policy/win/sandbox_win.cc), so this program leaves it out too.
  if (is_win) {
    configs -= [ "//build/config/compiler:cet_shadow_stack" ]
  }
}
