# Blink's Web IDL database: the interfaces, dictionaries and other definitions
# of every Web IDL file that Blink exposes to pages, in one file that says
# nothing yet about how bindings are written. The bindings generator below reads
# it.
#
# These targets run Blink's own scripts on Blink's own lists of files, as
# Blink's build does. Blink's targets cannot be used as they are, because their
# visibility leaves out everything outside Blink. They also read the IDL files
# that only Blink's own tests see, such as those of `internals`, which a page
# never has and which Blink generates from files of its own. This database
# leaves them out, and with them the one file of Blink's list for pages that
# only adds to them.
#
# Upstream: third_party/blink/renderer/bindings/BUILD.gn

import("//build/config/python.gni")
import("//mitto/bindings/generated_files.gni")
import("//mitto/bindings/interfaces.gni")
import("//third_party/blink/renderer/bindings/idl_in_core.gni")
import("//third_party/blink/renderer/bindings/idl_in_modules.gni")

# Collects the IDL files of one of Blink's components into one file.
template("collect_idl_files") {
  action_with_pydeps(target_name) {
    script =
        "//third_party/blink/renderer/bindings/scripts/collect_idl_files.py"
    inputs = invoker.inputs
    outputs = [ invoker.output ]

    # The list of files goes into a file of its own, which is too long for a
    # command line.
    response_file_contents = rebase_path(inputs, root_build_dir)
    args = [
      "--idl_list_file",
      "{{response_file_name}}",
      "--component",
      invoker.component,
      "--output",
      rebase_path(invoker.output, root_build_dir),
    ]
  }
}

collect_idl_files("web_idl_in_core") {
  component = "core"

  # Blink lists this file with those of pages, but it only adds to Internals,
  # which only Blink's tests have.
  inputs = filter_exclude(
          static_idl_files_in_core,
          [ "//third_party/blink/renderer/core/timing/internals_profiler.idl" ])
  output = "$target_gen_dir/web_idl_in_core.pickle"
}

collect_idl_files("web_idl_in_modules") {
  component = "modules"
  inputs = static_idl_files_in_modules
  output = "$target_gen_dir/web_idl_in_modules.pickle"
}

# Builds a database from the IDL files that collect_idl_files() collected, as
# the targets in `components` name them.
template("build_web_idl_database") {
  action_with_pydeps(target_name) {
    script =
        "//third_party/blink/renderer/bindings/scripts/build_web_idl_database.py"
    components = []
    foreach(component, invoker.components) {
      components += get_target_outputs(component)
    }

    # Which features are on for stable, and the like, which the database
    # records for each definition.
    runtime_enabled_features =
        "//third_party/blink/renderer/platform/runtime_enabled_features.json5"
    inputs = components + [ runtime_enabled_features ]
    outputs = [ invoker.output ]
    args = [
             "--output",
             rebase_path(outputs[0], root_build_dir),
             "--runtime_enabled_features",
             rebase_path(runtime_enabled_features, root_build_dir),
             "--",
           ] + rebase_path(components, root_build_dir)
    deps = invoker.components
  }
}

build_web_idl_database("web_idl_database") {
  components = [
    ":web_idl_in_core",
    ":web_idl_in_modules",
  ]
  output = "$target_gen_dir/web_idl_database.pickle"
}

# The bindings: what the generator writes from the database for every
# interface, namespace and callback interface that a page can reach, and the
# code they run on. docs/runtime.md says how the generator works.

_generated_dir = "$root_gen_dir/mitto/bindings"
_generated_runtime = [
  "runtime_features.cc",
  "runtime_features.h",
]

# Reads the whole database, and stops the build if anything in it is a
# construct, a type or an extended attribute that the generator does not
# handle. It writes the C++ for the interfaces with a class in interfaces.gni,
# the tables of all others that a page can reach, and a listing of every
# interface and member it planned, which the release routine compares between
# two Engine Releases.
action_with_pydeps("generate_bindings") {
  script = "generate_bindings.py"
  database = get_target_outputs(":web_idl_database")
  runtime_enabled_features =
      "//third_party/blink/renderer/platform/runtime_enabled_features.json5"
  inputs = database + [ runtime_enabled_features ]
  outputs = [ "$_generated_dir/web_idl_listing.txt" ]
  args = [
    "--source-root=" + rebase_path("//", root_build_dir),
    "--database",
    rebase_path(database[0], root_build_dir),
    "--runtime-enabled-features",
    rebase_path(runtime_enabled_features, root_build_dir),
    "--output-dir",
    rebase_path(_generated_dir, root_build_dir),
    "--listing",
    rebase_path(outputs[0], root_build_dir),
  ]
  foreach(file, _generated_runtime + mitto_bindings_generated_dom_files) {
    outputs += [ "$_generated_dir/$file" ]
    args += [
      "--output",
      file,
    ]
  }
  foreach(interface, mitto_bindings_interfaces) {
    args += [
      "--interface",
      interface.name,
    ]
    if (defined(interface.missing)) {
      foreach(member, interface.missing) {
        args += [
          "--missing",
          "${interface.name}.$member",
        ]
      }
    }
    if (defined(interface.implemented)) {
      args += [
        "--only-implemented",
        interface.name,
      ]
      foreach(member, interface.implemented) {
        args += [
          "--implemented",
          "${interface.name}.$member",
        ]
      }
    }
  }
  deps = [ ":web_idl_database" ]
}

# The code that the generated bindings run on, which knows no interface.
source_set("bindings") {
  sources = [
    "exception_context.cc",
    "exception_context.h",
    "exception_messages.cc",
    "exception_messages.h",
    "exception_state.cc",
    "exception_state.h",
    "idl_conversions.cc",
    "idl_conversions.h",
    "idl_member_installer.cc",
    "idl_member_installer.h",
    "idl_type_info.h",
    "interface_table.cc",
    "interface_table.h",
    "known_gap.cc",
    "known_gap.h",
    "per_isolate_data.cc",
    "per_isolate_data.h",
    "runtime_feature_set.cc",
    "runtime_feature_set.h",
    "script_wrappable.cc",
    "script_wrappable.h",
    "v8_conversions.cc",
    "v8_conversions.h",
    "wrapper_type_info.h",
  ]
  foreach(file, _generated_runtime) {
    sources += [ "$_generated_dir/$file" ]
  }
  public_deps = [
    ":generate_bindings",
    "//base",
    "//v8",
  ]
}

# The generator's test: a database of test/unknown_extended_attribute.idl, whose
# extended attribute no Engine Release has, which the generator must refuse
# with a message that names it.
collect_idl_files("generator_test_idl") {
  component = "core"
  inputs = [ "test/unknown_extended_attribute.idl" ]
  output = "$target_gen_dir/generator_test_idl.pickle"
}

build_web_idl_database("generator_test_database") {
  components = [ ":generator_test_idl" ]
  output = "$target_gen_dir/generator_test_database.pickle"
}

action_with_pydeps("generator_test") {
  script = "test/generator_test.py"
  database = get_target_outputs(":generator_test_database")
  inputs = database
  outputs = [ "$target_gen_dir/generator_test.stamp" ]
  args = [
    "--source-root=" + rebase_path("//", root_build_dir),
    "--database",
    rebase_path(database[0], root_build_dir),
    "--expect",
    "interface Thing: the generator does not handle the extended attribute [Unheard]",
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
  ]
  deps = [ ":generator_test_database" ]
}
