# The Encoding Standard's decoders and the registry of their labels, as Blink's
# WTF has them, which TextDecoder and TextEncoder use. The single-byte
# encodings beyond windows-1252, and the indexes of the CJK ones, come from
# ICU's converters, in the data that the Page program holds. Nothing here goes
# into the library: a Page runs in a process of its own.

source_set("encoding") {
  sources = [
    "encoding_tables.cc",
    "encoding_tables.h",
    "text_codec.cc",
    "text_codec.h",
    "text_codec_cjk.cc",
    "text_codec_cjk.h",
    "text_codec_icu.cc",
    "text_codec_icu.h",
    "text_codec_latin1.cc",
    "text_codec_latin1.h",
    "text_codec_replacement.cc",
    "text_codec_replacement.h",
    "text_codec_user_defined.cc",
    "text_codec_user_defined.h",
    "text_codec_utf16.cc",
    "text_codec_utf16.h",
    "text_codec_utf8.cc",
    "text_codec_utf8.h",
    "text_encoding_registry.cc",
    "text_encoding_registry.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//third_party/icu" ]
}
